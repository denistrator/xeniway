{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "apps/**/*.{js,jsx,ts,tsx,mjs,cjs}",
      "packages/**/*.{js,jsx,ts,tsx,mjs,cjs}",
      "scripts/**/*.{js,jsx,ts,tsx,mjs,cjs}",
      "tests/**/*.{js,jsx,ts,tsx,mjs,cjs}",
      "*.{js,jsx,ts,tsx,mjs,cjs}",
      "!!**/dist",
      "!!**/node_modules",
      "!!.worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNestedTernary": "error",
        "noParameterAssign": {
          "level": "error",
          "options": {
            "propertyAssignment": "allow"
          }
        },
        "noUselessElse": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useSingleVarDeclarator": "error",
        "useBlockStatements": "error"
      },
      "complexity": {
        "noImplicitCoercions": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "a11y": {
        "noLabelWithoutControl": "off"
      }
    }
  }
}
